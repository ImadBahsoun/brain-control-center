{
  "name": "brain-control-center",
  "version": "0.1.0",
  "private": true,
  "description": "Local, read-only dashboard over the Brain task store, governor policy and brain-gate state.",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev -H 127.0.0.1 -p 3077",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start -H 127.0.0.1 -p 3077",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "cross-env NEXT_TELEMETRY_DISABLED=1 vitest run"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
